---
layout: null
permalink: ./rss.xml
---
{%- assign og_image = site.og_image | default: site.author.avatar | default: site.github.owner_gravatar_url -%}
{%- include snippets/feed-entries.html -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
	<channel>
		<title>{{ site.title | append: " | " | append: site.subtitle | xml_escape  }}</title>
		<generator>(c) Chulapa Jekyll Theme RSS generator</generator>
		<link>{{  ""  | absolute_url }}</link>
		<description>{{ site.description | default: site.github.project_tagline | default: site.subtitle | default: site.title | default: "Recent entries" | xml_escape }}</description>
		<language>{{- feed_language -}}</language>
		<copyright>(c) {{ site.time | date: '%Y' }}, {{  site.author.name | default: site.github.owner_name | xml_escape }}</copyright>
		{% if alldocs.first %}<pubDate>{{ alldocs.first.date | date_to_rfc822 }}</pubDate>{% endif %}
		<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
		<category>blog</category>
		<ttl>60</ttl>
		<atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
		{% if og_image %}
		<image>
			<title>{{ site.title | append: " | " | append: site.subtitle | xml_escape }}</title>
			<url>{{ og_image | absolute_url | xml_escape }}</url>
			<link>{{ ""  | absolute_url -}}</link>
			<description>{{ site.description |  default: site.github.project_tagline | xml_escape }}</description>
		</image>
		{% endif %}
		{%- assign wpm = words_per_minute | default: 200 -%}
		{%- for document in alldocs -%}
{%- include snippets/canonical-url.html url=document.url canonical=document.canonical_url -%}
		{%- assign ogimage = document.og_image | default: document.header_img | 
		            default: site.og_image -%}
		{%- assign words = document.content | strip_html | number_of_words -%}
		{%- assign minutes = words | divided_by: wpm | ceil | at_least: 1 -%}
		{% include snippets/author-identity.html author=document.author %}
		<item>
			{% if identity_name != empty %}<dc:creator>{{ identity_name | xml_escape }}</dc:creator>{% endif %}
			<title>{{ document.title | markdownify | strip_html | strip_newlines | strip | replace: '&amp;', '&' | xml_escape }}</title>
			{% capture item_html %}
 				{% if document.subtitle %}<h3>{{ document.subtitle | markdownify | remove: '<p>' | remove: '</p>' | strip | strip_newlines }}</h3>{% endif %}
				<p>{{ minutes }} min.</p>
				<div>{{ document.content
				| markdownify }}</div>
				{% endcapture %}
			<description>{{ document.excerpt | default: item_html | xml_escape }}</description>
			<content:encoded>{{ item_html | xml_escape }}</content:encoded>
			<link>{{ canonical_url | escape }}</link>
			<category>{{ document.collection | xml_escape }}</category>
		    {% if document.tags.size > 0 -%}
				{%- assign tagrss = document.tags | sort | where_exp: "tag","tag != document.layout "   -%}
			    {% for tag in tagrss  -%}
			<category>{{ tag | xml_escape }}</category>
			    {%- endfor %}
		  	{%- endif %}
		  	{%- if ogimage -%}
			<media:title type="plain">{{ document.title | markdownify | strip_html | strip | replace: '&amp;', '&' | xml_escape }}</media:title>
      <media:content url="{{ ogimage | absolute_url | xml_escape }}" medium="image"/>
      <media:thumbnail url="{{ ogimage | absolute_url | xml_escape }}" />
      {%- endif -%}
      <guid isPermaLink="true">{{ document.url | absolute_url | xml_escape }}</guid>
      <pubDate>{{ document.date | date_to_rfc822 }}</pubDate>
      {% if document.last_modified_at %}<dcterms:modified>{{ document.last_modified_at | date_to_xmlschema }}</dcterms:modified>{% endif %}
		</item>
		{%- endfor -%}
	</channel>
</rss>
